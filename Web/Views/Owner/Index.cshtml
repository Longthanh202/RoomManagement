            <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button><span class="rc-eyebrow">ĐỘI NGŨ</span><h2 id="assignEmployeeTitle" class="modal-title">Phân công nhân viên</h2><p id="assignEmployeeDescription">Chọn khu trọ và ngày bắt đầu phụ trách.</p></div>
            <div class="modal-body">
                @using (Html.BeginRouteForm("OwnerAssignEmployee", new { }, FormMethod.Post, new { @class = "rc-modal-form", id = "assignEmployeeForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="AssignNhanVienId" name="NhanVienId" />
                    <label for="AssignKhuTroId">Khu trọ</label><select id="AssignKhuTroId" name="KhuTroId" class="form-control" required><option value="">Chọn khu trọ</option>@foreach (var khu in Model.KhuTro) { <option value="@khu.Id">@khu.TenKhuTro</option> }</select>
                    <label for="AssignNgayBatDau">Ngày bắt đầu</label><input id="AssignNgayBatDau" name="NgayBatDau" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    <label for="AssignGhiChu">Ghi chú</label><textarea id="AssignGhiChu" name="GhiChu" class="form-control" rows="2"></textarea>
                    <div class="rc-modal-actions"><button type="button" class="btn rc-btn-secondary" data-dismiss="modal">Hủy</button><button class="btn rc-btn-primary" type="submit">Lưu phân công</button></div>
                }
            </div>
        </div></div>
    </div>

    <div class="modal fade rc-modal" id="addMemberModal" tabindex="-1" role="dialog" aria-labelledby="addMemberTitle">
        <div class="modal-dialog" role="document"><div class="modal-content">
            <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button><span class="rc-eyebrow">THÀNH VIÊN PHÒNG</span><h2 id="addMemberTitle" class="modal-title">Thêm thành viên</h2><p id="addMemberDescription">Chọn hồ sơ cư dân chưa có hợp đồng đang hiệu lực.</p></div>
            <div class="modal-body">
                @using (Html.BeginRouteForm("OwnerAddRoomMember", new { }, FormMethod.Post, new { @class = "rc-modal-form", id = "addRoomMemberForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="MemberHopDongId" name="HopDongId" />
                    <label for="MemberCuDanId">Cư dân</label><select id="MemberCuDanId" name="CuDanId" class="form-control" required><option value="">Chọn cư dân</option>@foreach (var resident in Model.CuDan.Where(x => !x.HopDong.Any(h => h.CuDanDaiDienId == x.Id && (h.TrangThai == "ChoDuyet" || h.TrangThai == "DangHieuLuc")) && !x.HopDongThanhVien.Any(m => m.TrangThai && (m.HopDong.TrangThai == "ChoDuyet" || m.HopDong.TrangThai == "DangHieuLuc")))) { <option value="@resident.Id">@resident.HoTen @(resident.TaiKhoan == null ? "(chưa có tài khoản)" : "")</option> }</select>
                    <label for="MemberNgayBatDau">Ngày bắt đầu cư trú</label><input id="MemberNgayBatDau" name="NgayBatDau" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    <div class="rc-modal-actions"><button type="button" class="btn rc-btn-secondary" data-dismiss="modal">Hủy</button><button class="btn rc-btn-primary" type="submit">Thêm thành viên</button></div>
                }
            </div>
        </div></div>
    </div>

    <div class="modal fade rc-modal" id="servicePriceModal" tabindex="-1" role="dialog" aria-labelledby="servicePriceTitle">
        <div class="modal-dialog" role="document"><div class="modal-content">
            <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button><span class="rc-eyebrow">BẢNG GIÁ</span><h2 id="servicePriceTitle" class="modal-title">Cập nhật giá dịch vụ</h2><p>Đơn giá mới sẽ lưu lịch sử giá cũ theo thời gian hiệu lực.</p></div>
            <div class="modal-body">
                @using (Html.BeginRouteForm("OwnerSetServicePrice", new { }, FormMethod.Post, new { @class = "rc-modal-form" }))
                {
                    @Html.AntiForgeryToken()
                    <label for="PriceKhuTroId">Khu trọ</label><select id="PriceKhuTroId" name="KhuTroId" class="form-control" required><option value="">Chọn khu trọ</option>@foreach (var khu in Model.KhuTro) { <option value="@khu.Id">@khu.TenKhuTro</option> }</select>
                    <label for="DichVuId">Dịch vụ</label><select id="DichVuId" name="DichVuId" class="form-control" required><option value="">Chọn dịch vụ</option>@foreach (var service in Model.DichVu) { <option value="@service.Id">@service.TenDichVu · @service.DonViTinh</option> }</select>
                    <label for="DonGia">Đơn giá (₫)</label><input id="DonGia" name="DonGia" class="form-control" type="number" min="0" step="100" required />
                    <label for="TuNgay">Ngày áp dụng</label><input id="TuNgay" name="TuNgay" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    <div class="rc-modal-actions"><button type="button" class="btn rc-btn-secondary" data-dismiss="modal">Hủy</button><button class="btn rc-btn-primary" type="submit">Lưu giá dịch vụ</button></div>
                }
            </div>
        </div></div>
    </div>

    <div class="modal fade rc-modal" id="createServiceModal" tabindex="-1" role="dialog" aria-labelledby="createServiceTitle">
        <div class="modal-dialog" role="document"><div class="modal-content">
            <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button><span class="rc-eyebrow">DANH MỤC</span><h2 id="createServiceTitle" class="modal-title">Thêm dịch vụ</h2><p>Khai báo dịch vụ mới để áp dụng cho các khu trọ.</p></div>
            <div class="modal-body">
                @using (Html.BeginRouteForm("OwnerCreateService", new { }, FormMethod.Post, new { @class = "rc-modal-form" }))
                {
                    @Html.AntiForgeryToken()
                    <label for="MaDichVu">Mã dịch vụ</label><input id="MaDichVu" name="MaDichVu" class="form-control" maxlength="50" placeholder="Ví dụ: NUOC" pattern="[A-Za-z0-9_-]+" required />
                    <label for="TenDichVu">Tên dịch vụ</label><input id="TenDichVu" name="TenDichVu" class="form-control" maxlength="200" required />
                    <label for="LoaiTinhPhi">Phương thức tính</label><select id="LoaiTinhPhi" name="LoaiTinhPhi" class="form-control" required><option value="TheoChiSo">Theo chỉ số (điện, nước)</option><option value="CoDinh">Cố định</option><option value="TheoNguoi">Theo người</option><option value="TheoXe">Theo xe</option><option value="TheoSoLuong">Theo số lượng</option><option value="TuNhap">Nhập thủ công</option></select>
                    <label for="DonViTinh">Đơn vị tính</label><input id="DonViTinh" name="DonViTinh" class="form-control" maxlength="50" placeholder="kWh, m³, người..." />
                    <label for="MoTaDichVu">Mô tả</label><textarea id="MoTaDichVu" name="MoTa" class="form-control" maxlength="500" rows="2"></textarea>
                    <div class="rc-modal-actions"><button type="button" class="btn rc-btn-secondary" data-dismiss="modal">Hủy</button><button class="btn rc-btn-primary" type="submit">Thêm dịch vụ</button></div>
                }
            </div>
        </div></div>
    </div>

    <div class="modal fade rc-modal" id="notificationsModal" tabindex="-1" role="dialog" aria-labelledby="notificationsTitle">
        <div class="modal-dialog" role="document"><div class="modal-content">
            <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button><span class="rc-eyebrow">CẬP NHẬT</span><h2 id="notificationsTitle" class="modal-title">Thông báo</h2><p>@Model.SoThongBaoChuaDoc thông báo chưa đọc</p></div>
            <div class="modal-body">
                @if (Model.ThongBao.Count == 0)
                {
                    <div class="rc-empty-state"><strong>Chưa có thông báo</strong><span>Các cập nhật gửi đến tài khoản sẽ xuất hiện ở đây.</span></div>
                }
                else
                {
                    <div class="rc-notification-list">
                        @foreach (var recipient in Model.ThongBao)
                        {
                            <article class="rc-notification-item @(recipient.DaDoc ? "" : "is-unread")">
                                <div><strong>@recipient.ThongBao.TieuDe</strong><p>@recipient.ThongBao.NoiDung</p><small>@recipient.ThongBao.NgayTao.ToString("dd/MM/yyyy HH:mm")</small></div>
                                @if (!recipient.DaDoc)
                                {
                                    using (Html.BeginRouteForm("OwnerMarkNotificationRead", new { id = recipient.Id }, FormMethod.Post, new { @class = "rc-inline-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button class="rc-text-button" type="submit">Đã đọc</button>
                                    }
                                }
                            </article>
                        }
                    </div>
                }
            </div>
        </div></div>
    </div>

    <div class="modal fade rc-modal" id="residentDetailsModal" tabindex="-1" role="dialog" aria-labelledby="residentDetailsTitle">
        <div class="modal-dialog" role="document"><div class="modal-content">
            <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button><span class="rc-eyebrow">HỒ SƠ CƯ DÂN</span><h2 id="residentDetailsTitle" class="modal-title">Chi tiết cư dân</h2></div>
            <div class="modal-body"><dl class="rc-detail-list"><dt>Họ tên</dt><dd id="detailResidentName"></dd><dt>Số điện thoại</dt><dd id="detailResidentPhone"></dd><dt>Email</dt><dd id="detailResidentEmail"></dd><dt>CCCD</dt><dd id="detailResidentId"></dd><dt>Địa chỉ thường trú</dt><dd id="detailResidentAddress"></dd><dt>Phòng hiện tại</dt><dd id="detailResidentRoom"></dd></dl></div>
        </div></div>
    </div>

    <div class="modal fade rc-modal" id="contractDetailsModal" tabindex="-1" role="dialog" aria-labelledby="contractDetailsTitle">
        <div class="modal-dialog" role="document"><div class="modal-content">
            <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button><span class="rc-eyebrow">HỒ SƠ THUÊ PHÒNG</span><h2 id="contractDetailsTitle" class="modal-title">Chi tiết hợp đồng</h2></div>
            <div class="modal-body"><dl class="rc-detail-list"><dt>Mã hợp đồng</dt><dd id="detailContractCode"></dd><dt>Người đại diện</dt><dd id="detailContractResident"></dd><dt>Phòng / khu trọ</dt><dd id="detailContractRoom"></dd><dt>Thời hạn</dt><dd id="detailContractTerm"></dd><dt>Giá thuê</dt><dd id="detailContractRent"></dd><dt>Tiền cọc</dt><dd id="detailContractDeposit"></dd><dt>Ngày thanh toán</dt><dd id="detailContractPayment"></dd><dt>Thành viên đang hoạt động</dt><dd id="detailContractMembers"></dd><dt>Điều khoản bổ sung</dt><dd id="detailContractTerms"></dd></dl></div>
        </div></div>
    </div>

    <script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/bootstrap.min.js")"></script>
    <script>
        (function ($) {
            var $sidebar = $("#ownerSidebar");
            function showPanel(name) {
                $(".rc-workspace-panel").removeClass("is-active");
                $("#panel-" + name).addClass("is-active");
                $(".rc-sidebar-nav button").removeClass("is-active");
                $('.rc-sidebar-nav button[data-panel-target="' + name + '"]').addClass("is-active");
                $sidebar.removeClass("is-open");
                $("#sidebarBackdrop").removeClass("is-visible");
                window.scrollTo(0, 0);
            }

            $("[data-panel-target]").on("click", function () {
                var name = $(this).data("panel-target");
                if ($("#panel-" + name).length) {
                    showPanel(name);
                }
            });

            $("#sidebarToggle, #sidebarBackdrop").on("click", function () {
                $sidebar.toggleClass("is-open");
                $("#sidebarBackdrop").toggleClass("is-visible");
            });

            function filterChildren($source, $target, attribute) {
                var selected = $source.val();
                $target.val("");
                $target.find("option").each(function () {
                    var $option = $(this);
                    var parent = $option.data(attribute);
                    $option.prop("hidden", !!parent && String(parent) !== String(selected));
                });
            }

            $("#FloorKhuTroId").on("change", function () {
                filterChildren($(this), $("#FloorDayTroId"), "khu");
            });
            $("#RoomKhuTroId").on("change", function () {
                filterChildren($(this), $("#RoomDayTroId"), "khu");
                filterChildren($("#RoomDayTroId"), $("#TangId"), "day");
            });
            $("#RoomDayTroId").on("change", function () {
                filterChildren($(this), $("#TangId"), "day");
            });

            $("#assignEmployeeModal").on("show.bs.modal", function (event) {
                var button = $(event.relatedTarget);
                $("#AssignNhanVienId").val(button.data("employee-id") || "");
                $("#assignEmployeeDescription").text(button.data("employee-name")
                    ? "Phân công " + button.data("employee-name") + " phụ trách khu trọ."
                    : "Chọn nhân viên, khu trọ và ngày bắt đầu phụ trách.");
                if (button.data("employee-id")) {
                    $("#AssignNhanVienId").val(button.data("employee-id"));
                }
            });

            $("#addMemberModal").on("show.bs.modal", function (event) {
                var button = $(event.relatedTarget);
                $("#MemberHopDongId").val(button.data("contract-id") || "");
                $("#addMemberDescription").text(button.data("room-name")
                    ? "Chọn cư dân đủ điều kiện để thêm vào phòng " + button.data("room-name") + "."
                    : "Chọn hồ sơ cư dân chưa có hợp đồng đang hiệu lực.");
            });

            $("#residentDetailsModal").on("show.bs.modal", function (event) {
                var button = $(event.relatedTarget);
                $("#detailResidentName").text(button.data("name"));
                $("#detailResidentPhone").text(button.data("phone"));
                $("#detailResidentEmail").text(button.data("email"));
                $("#detailResidentId").text(button.data("id"));
                $("#detailResidentAddress").text(button.data("address"));
                $("#detailResidentRoom").text(button.data("room"));
            });

            $("#contractDetailsModal").on("show.bs.modal", function (event) {
                var button = $(event.relatedTarget);
                $("#detailContractCode").text(button.data("code"));
                $("#detailContractResident").text(button.data("resident"));
                $("#detailContractRoom").text(button.data("room") + " · " + button.data("location"));
                $("#detailContractTerm").text(button.data("start") + " – " + button.data("end"));
                $("#detailContractRent").text(button.data("rent"));
                $("#detailContractDeposit").text(button.data("deposit"));
                $("#detailContractPayment").text("Ngày " + button.data("payment") + " hàng tháng");
                $("#detailContractMembers").text(button.data("members") || "Chưa có thành viên");
                $("#detailContractTerms").text(button.data("terms"));
            });
        })(jQuery);
    </script>
</body>
</html>
