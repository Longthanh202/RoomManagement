@model Web.Models.ViewModel.ChangePasswordViewModel

@{ ViewBag.Title = "Đổi mật khẩu";
                Layout = null; }

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đổi mật khẩu</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4f6fb;
            font-family: Arial, sans-serif;
        }

        .password-card {
            width: 100%;
            max-width: 460px;
            background: #fff;
            border-radius: 16px;
            padding: 35px;
            box-shadow: 0 8px 35px rgba(0,0,0,0.07);
        }

        .icon-box {
            width: 65px;
            height: 65px;
            border-radius: 16px;
            background: #eaf1ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 27px;
            margin: 0 auto 20px;
        }

        .form-control {
            height: 48px;
            border-radius: 9px;
        }

        .input-group-text {
            background: white;
            cursor: pointer;
        }

        .btn-submit {
            height: 48px;
            border-radius: 9px;
            font-weight: 600;
            background: #2563eb;
            border: none;
        }

            .btn-submit:hover {
                background: #1d4ed8;
            }

        .validation-summary-errors {
            color: #dc3545;
            font-size: 14px;
        }

            .validation-summary-errors ul {
                margin-bottom: 0;
                padding-left: 20px;
            }

        .field-validation-error {
            color: #dc3545;
            font-size: 12px;
        }
    </style>
</head>

<body>

    <div class="password-card">

        <div class="text-center">
            <div class="icon-box">
                <i class="fa-solid fa-lock"></i>
            </div>

            <h4 class="fw-bold mb-2">Đổi mật khẩu</h4>

            <p class="text-muted mb-4">
                Vui lòng đổi mật khẩu để tiếp tục sử dụng hệ thống.
            </p>
        </div>

        @using (Html.BeginForm("ChangePassword", "Account",
            FormMethod.Post, new { @class = "password-form" }))
        {
@Html.AntiForgeryToken()

                @Html.ValidationSummary(false, "",
                         new { @class = "text-danger mb-3" })

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">
                                        Mật khẩu hiện tại
                                    </label>

                                    <div class="input-group">
                                        @Html.PasswordFor(m => m.MatKhauCu,
                                                 new { @class = "form-control", placeholder = "Nhập mật khẩu hiện tại", id = "MatKhauCu" })

                                        <span class="input-group-text"
                                              onclick="togglePassword('MatKhauCu', this)">
                                            <i class="fa-regular fa-eye"></i>
                                        </span>
                                    </div>

                                    @Html.ValidationMessageFor(m => m.MatKhauCu)
                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">
                                                        Mật khẩu mới
                                                    </label>

                                                    <div class="input-group">
                                                        @Html.PasswordFor(m => m.MatKhauMoi,
                                                                 new { @class = "form-control", placeholder = "Nhập mật khẩu mới", id = "MatKhauMoi" })

                                                        <span class="input-group-text"
                                                              onclick="togglePassword('MatKhauMoi', this)">
                                                            <i class="fa-regular fa-eye"></i>
                                                        </span>
                                                    </div>

                                                    @Html.ValidationMessageFor(m => m.MatKhauMoi)
                                                </div>

                                                                <div class="mb-4">
                                                                    <label class="form-label fw-semibold">
                                                                        Xác nhận mật khẩu mới
                                                                    </label>

                                                                    <div class="input-group">
                                                                        @Html.PasswordFor(m => m.XacNhanMatKhau,
                                                                                 new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới", id = "XacNhanMatKhau" })

                                                                        <span class="input-group-text"
                                                                              onclick="togglePassword('XacNhanMatKhau', this)">
                                                                            <i class="fa-regular fa-eye"></i>
                                                                        </span>
                                                                    </div>

                                                                    @Html.ValidationMessageFor(m => m.XacNhanMatKhau)
                                                                </div>

                                                                                <button type="submit"
                                                                                        class="btn btn-primary btn-submit w-100">
                                                                                    <i class="fa-solid fa-key me-2"></i>
                                                                                    Cập nhật mật khẩu
                                                                                </button>}

        <div class="text-center mt-3">
            <small class="text-muted">
                <i class="fa-solid fa-shield-halved me-1"></i>
                Thông tin của bạn được bảo mật
            </small>
        </div>

    </div>

    <script>function togglePassword(id, element) {
            var input = document.getElementById(id);
            var icon = element.querySelector("i");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }</script>

</body>
</html>
