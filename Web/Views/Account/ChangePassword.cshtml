@model Web.Models.ViewModel.ChangePasswordViewModel
@{
    Layout = null;
    ViewBag.Title = "Đổi mật khẩu | RoomCare";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123c35" />
    <title>@ViewBag.Title</title>
    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/roomcare.css")" rel="stylesheet" />
    <style>
        .rc-password-card {
            width: 100%;
            max-width: 470px;
            padding: 24px 20px;
            border: 1px solid var(--rc-line);
            border-radius: 16px;
            background: #fff;
            box-shadow: 0 12px 35px rgba(22, 57, 48, .06);
        }

        .rc-password-form .form-group {
            margin-bottom: 16px;
        }

        .rc-password-form label {
            display: block;
            margin-bottom: 7px;
            color: #344743;
            font-size: 13px;
            font-weight: 600;
        }

        .rc-password-form .form-control {
            max-width: none;
            height: 46px;
            border: 1px solid #dfe8e4;
            border-radius: 9px;
            box-shadow: none;
        }

        .rc-password-form .form-control:focus {
            border-color: #57a88c;
            box-shadow: 0 0 0 3px rgba(28, 117, 97, .1);
        }

        .rc-password-toggle {
            min-width: 54px;
            border: 1px solid #dfe8e4;
            border-left: 0;
            border-radius: 0 9px 9px 0;
            background: #fff;
            color: var(--rc-green);
            font-size: 12px;
            font-weight: 600;
        }

        .rc-password-help {
            margin-top: 16px;
            color: var(--rc-muted);
            font-size: 12px;
            line-height: 1.6;
        }

        @media (min-width: 560px) {
            .rc-password-card {
                padding: 32px;
            }
        }
    </style>
</head>
<body class="rc-auth-page">
    <main class="rc-auth-content">
        <section class="rc-password-card">
            <div class="rc-mobile-brand">
                <a class="rc-brand" href="@Url.Action("Login", "Account")">
                    <span class="rc-brand-mark" aria-hidden="true">R</span>
                    <span>Room<span>Care</span></span>
                </a>
            </div>
            <div class="rc-form-heading">
                <span class="rc-eyebrow">BẢO MẬT TÀI KHOẢN</span>
                <h2>Đổi mật khẩu</h2>
                <p>Đặt mật khẩu mới để tiếp tục sử dụng không gian RoomCare.</p>
            </div>
            @using (Html.BeginRouteForm("ChangePassWord", new { }, FormMethod.Post, new { @class = "rc-password-form", autocomplete = "on" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "rc-validation-summary" })
                <div class="form-group">
                    <label for="MatKhauCu">Mật khẩu hiện tại</label>
                    <div class="input-group">
                        @Html.PasswordFor(x => x.MatKhauCu, new { @class = "form-control", autocomplete = "current-password", placeholder = "Nhập mật khẩu hiện tại" })
                        <button class="rc-password-toggle" type="button" data-password-toggle="MatKhauCu" data-password-name="mật khẩu hiện tại" aria-label="Hiện mật khẩu hiện tại">Hiện</button>
                    </div>
                    @Html.ValidationMessageFor(x => x.MatKhauCu, "", new { @class = "field-validation-error" })
                </div>
                <div class="form-group">
                    <label for="MatKhauMoi">Mật khẩu mới</label>
                    <div class="input-group">
                        @Html.PasswordFor(x => x.MatKhauMoi, new { @class = "form-control", autocomplete = "new-password", placeholder = "Tối thiểu 8 ký tự" })
                        <button class="rc-password-toggle" type="button" data-password-toggle="MatKhauMoi" data-password-name="mật khẩu mới" aria-label="Hiện mật khẩu mới">Hiện</button>
                    </div>
                    @Html.ValidationMessageFor(x => x.MatKhauMoi, "", new { @class = "field-validation-error" })
                </div>
                <div class="form-group">
                    <label for="XacNhanMatKhau">Xác nhận mật khẩu mới</label>
                    <div class="input-group">
                        @Html.PasswordFor(x => x.XacNhanMatKhau, new { @class = "form-control", autocomplete = "new-password", placeholder = "Nhập lại mật khẩu mới" })
                        <button class="rc-password-toggle" type="button" data-password-toggle="XacNhanMatKhau" data-password-name="mật khẩu xác nhận" aria-label="Hiện mật khẩu xác nhận">Hiện</button>
                    </div>
                    @Html.ValidationMessageFor(x => x.XacNhanMatKhau, "", new { @class = "field-validation-error" })
                </div>
                <button class="btn rc-btn-primary rc-btn-block" type="submit">Cập nhật mật khẩu <span aria-hidden="true">→</span></button>
                <p class="rc-password-help">Mật khẩu mới phải có ít nhất 8 ký tự. Không chia sẻ mật khẩu với người khác.</p>
            }
        </section>
    </main>
    <script>
        document.querySelectorAll("[data-password-toggle]").forEach(function (button) {
            button.addEventListener("click", function () {
                var input = document.getElementById(button.getAttribute("data-password-toggle"));
                if (!input) {
                    return;
                }

                var show = input.type === "password";
                input.type = show ? "text" : "password";
                button.textContent = show ? "Ẩn" : "Hiện";
                button.setAttribute("aria-label", (show ? "Ẩn " : "Hiện ") + button.getAttribute("data-password-name"));
            });
        });
    </script>
</body>
</html>
